PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SITE_URL=https://www.chironegenmanneke.be
ADMIN_PATH_SLUG=leiding-login
SUPABASE_SERVICE_ROLE_KEY=
# Alleen lokaal nodig voor `npm run seed`.
# Niet instellen in Netlify: dit is geen runtime vereiste en kan
# door secret scanning als "exposed" gezien worden als het publieke
# contactadres ook op de site voorkomt.
ADMIN_EMAIL=

# Notifications: generate a VAPID pair ONCE, configure in server/function runtime too.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.org
# Explicitly enable only in the intended published environment.
NOTIFICATIONS_ENABLED=false
