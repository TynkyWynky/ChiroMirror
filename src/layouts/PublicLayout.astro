---
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PublicMotion from "@/components/PublicMotion.astro";
import type { SiteSettings } from "@/types/content";
import "@/styles/public-theme.css";
import "@/styles/public-motion.css";

interface Props {
  title: string;
  description: string;
  siteSettings: SiteSettings;
  socialImage?: string;
  socialImageAlt?: string;
  showMapFooter?: boolean;
  noIndex?: boolean;
}

const {
  title,
  description,
  siteSettings,
  socialImage = siteSettings.logoUrl,
  socialImageAlt = siteSettings.siteName,
  showMapFooter = false,
  noIndex = false
} = Astro.props;

function resolveBaseUrl(value: string) {
  try {
    return new URL(value).toString();
  } catch {
    return Astro.url.origin;
  }
}

function resolveUrl(value: string, base: string) {
  try {
    return new URL(value, base).toString();
  } catch {
    return value;
  }
}

const siteBaseUrl = resolveBaseUrl(siteSettings.siteUrl);
const canonicalUrl = resolveUrl(Astro.url.pathname, siteBaseUrl);
const socialImageUrl = socialImage.startsWith("http")
  ? socialImage
  : resolveUrl(socialImage, siteBaseUrl);
---

<!DOCTYPE html>
<html lang="nl" class="public-document">
  <head>
    <link rel="canonical" href={canonicalUrl} />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" href="/assets/chir9man%20logo.png" />
    <link rel="apple-touch-icon" href="/assets/chir9man%20logo.png" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <!-- Native pagereveal runs before deferred modules: register synchronously. -->
    <script is:inline>
      (() => {
        if (document.documentElement.dataset.pageTransitionsReady) return;
        document.documentElement.dataset.pageTransitionsReady = "true";
        const reduced = matchMedia("(prefers-reduced-motion: reduce)");
        let transition;
        const handle = event => {
          transition = event.viewTransition;
          if (!transition) return;
          transition.ready.catch(() => {});
          transition.finished.catch(() => {});
          transition.updateCallbackDone.catch(() => {});
          if (reduced.matches || document.body?.classList.contains("signup-motion-open")) transition.skipTransition();
        };
        addEventListener("pageswap", handle);
        addEventListener("pagereveal", handle);
        reduced.addEventListener("change", () => { if (reduced.matches) transition?.skipTransition(); });
      })();
    </script>
    <script>
      import "@/scripts/public-navigation";
      import "@/scripts/public-motion";
    </script>

    {siteSettings.analyticsId && (
      <>
        <meta name="x-analytics-id" content={siteSettings.analyticsId} />
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${siteSettings.analyticsId}`}
        ></script>
        <script is:inline defer src="/assets/analytics.js"></script>
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content={siteSettings.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

  </head>

  <body class="public-site">
    <a class="skip-link" href="#main-content">Naar de inhoud</a>
    <Navbar />
    <slot name="afterNav" />
    <main class="container" id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer siteSettings={siteSettings} showMap={showMapFooter} />
    <PublicMotion logoUrl={siteSettings.logoUrl} />
  </body>
</html>
