---
import PublicLayout from "@/layouts/PublicLayout.astro";
import PracticalLinks from "@/components/PracticalLinks.astro";
import RichText from "@/components/RichText.astro";
import { loadSiteContent } from "@/lib/content";
import { withDevFresh } from "@/lib/href";
import "@/styles/public-info.css";
const { siteSettings, pages } = await loadSiteContent();
const { home, registration, activities } = pages;
---

<PublicLayout title="Praktisch • Chiro Negenmanneke" description="Praktische informatie voor leden en ouders: werking, inschrijven, kledij, kamp en contact." siteSettings={siteSettings}>
  <div class="info-page practical-page">
    <header class="info-heading"><p class="info-kicker">Voor leden & ouders</p><h1>Goed voorbereid<br />naar de Chiro.</h1><p class="info-lead">{home.hero.badge}</p><div class="info-actions"><a class="btn" data-signup-motion href={withDevFresh("/inschrijven.html")}>Inschrijven <span aria-hidden="true">↗</span></a><a class="info-text-link" href={withDevFresh("/contact.html")}>Stel je vraag <span aria-hidden="true">→</span></a></div></header>
    <section class="practical-core" aria-labelledby="practical-core-title"><div><h2 id="practical-core-title">{home.practical.title}</h2><p>{home.practical.note}</p></div><dl class="info-facts">{home.practical.items.map(item => { const split = item.indexOf(":"); return <div><dt>{split < 0 ? item : item.slice(0, split)}</dt>{split >= 0 && <dd>{item.slice(split + 1).trim()}</dd>}</div>; })}</dl></section>
    <section class="info-location" aria-labelledby="practical-location"><h2 id="practical-location">Hier vind je ons</h2><p>{siteSettings.address}<br /><small>{siteSettings.addressNote}</small></p><div class="info-actions"><a class="btn btn-light" href={siteSettings.mapGoogleUrl} target="_blank" rel="noreferrer">Route via Google Maps <span aria-hidden="true">↗</span></a><a class="info-text-link" href={siteSettings.mapAppleUrl} target="_blank" rel="noreferrer">Apple Maps <span aria-hidden="true">↗</span></a></div></section>
    <section class="info-questions" aria-labelledby="practical-questions"><h2 id="practical-questions">Even op een rij</h2><details open><summary>{home.about.title}</summary><RichText content={home.about.body} /></details><details><summary>{registration.stepsTitle}</summary><ol>{registration.steps.map(step => <li>{step}</li>)}</ol><a class="info-text-link" href={withDevFresh("/inschrijven.html")}>Alle inschrijfinformatie <span aria-hidden="true">→</span></a></details><details><summary>{registration.clothesTitle}</summary><p>{registration.clothesBody}</p><a class="info-text-link" href={withDevFresh("/inschrijven.html#kledij")}>Bekijk onze kledij <span aria-hidden="true">→</span></a></details></section>
    {activities.bookletUrl && <aside class="info-download"><h2>Het activiteitenboekje</h2><a class="btn" href="/api/booklet">Download het boekje <span aria-hidden="true">↓</span></a></aside>}
    <PracticalLinks />
  </div>
</PublicLayout>
