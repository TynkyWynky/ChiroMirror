---
import PublicLayout from "@/layouts/PublicLayout.astro";
import RichText from "@/components/RichText.astro";
import ContactForm from "@/components/ContactForm";
import { loadSiteContent } from "@/lib/content";
import PracticalLinks from "@/components/PracticalLinks.astro";
import LeaderCards from "@/components/LeaderCards.astro";
import { groupHref } from "@/lib/group-presentation";
import { withDevFresh } from "@/lib/href";
import "@/styles/departments.css";
import "@/styles/public-info.css";

const content = await loadSiteContent();
const { siteSettings, pages, groups, contactSections } = content;
const contactPage = pages.contact;
const groupOrderLookup = new Map(
  contactPage.groupCards.map((item, index) => [item.groupSlug, index])
);
const orderedGroups = [...groups].sort((left, right) => {
  const leftOrder = groupOrderLookup.get(left.slug);
  const rightOrder = groupOrderLookup.get(right.slug);

  if (leftOrder !== undefined && rightOrder !== undefined) {
    return leftOrder - rightOrder;
  }

  if (leftOrder !== undefined) {
    return -1;
  }

  if (rightOrder !== undefined) {
    return 1;
  }

  return left.sortOrder - right.sortOrder || left.name.localeCompare(right.name, "nl");
});
---

<PublicLayout
  title="Contact • Chiro Negenmanneke"
  description="Contacteer Chiro Negenmanneke: locatie, e-mail en sociale media."
  siteSettings={siteSettings}
>
  <form name="contact" method="POST" data-netlify="true" netlify-honeypot="website" hidden>
    <input type="hidden" name="form-name" value="contact" />
    <input name="naam" />
    <input name="email" type="email" />
    <input name="onderwerp" />
    <input name="categorie" />
    <textarea name="bericht"></textarea>
    <input name="website" />
  </form>

  <div class="info-page contact-page">
    <header class="info-heading"><p class="info-kicker">We horen graag van je</p><h1>{contactPage.title}</h1><div class="info-actions"><a class="btn" href="#bericht">Stuur een bericht <span aria-hidden="true">↓</span></a><a class="info-text-link" href="#contactpersonen">Contactpersonen <span aria-hidden="true">↓</span></a></div></header>
    <div class="contact-top-grid">
      <section class="contact-general" aria-labelledby="contact-general-title"><h2 id="contact-general-title">{contactPage.generalTitle}</h2><RichText content={contactPage.generalBody} /><div class="contact-location"><h3>Hier vind je ons</h3><p>{siteSettings.address}<br /><small>{siteSettings.addressNote}</small></p><a class="info-text-link" href={siteSettings.mapGoogleUrl} target="_blank" rel="noreferrer">Plan je route <span aria-hidden="true">↗</span></a></div></section>
      <section class="contact-message" id="bericht" aria-labelledby="contact-form-title"><h2 id="contact-form-title">{contactPage.formTitle}</h2><p class="contact-form-note">Velden met * zijn verplicht.</p><ContactForm client:load categories={contactPage.formCategories} successMessage={contactPage.successMessage} errorMessage={contactPage.errorMessage} fallbackEmail={siteSettings.email} /></section>
    </div>
    <section class="contact-directory-section" id="contactpersonen" aria-labelledby="contact-directory-title"><div class="info-section-heading"><h2 id="contact-directory-title">{contactPage.sectionsTitle}</h2><a class="info-text-link" href={withDevFresh("/leiding.html")}>Ontmoet de leiding <span aria-hidden="true">↗</span></a></div>
      <div class="departments contact-directory">
        {orderedGroups.map(group => <section class="contact-team" aria-labelledby={`contact-${group.slug}`} style={`--department: var(--${group.themeKey}, var(--burgundy))`}><h3 id={`contact-${group.slug}`}><a href={withDevFresh(groupHref(group.slug))}>{group.name}</a></h3><div class="contact-card-people"><LeaderCards people={group.leaders} headingLevel="h4" /></div></section>)}
        {contactSections.map((section, index) => <section class="contact-team" aria-labelledby={`contact-extra-${index}`} style={`--department: ${section.accentColor || "var(--burgundy)"}`}><h3 id={`contact-extra-${index}`}>{section.title}</h3><div class="contact-card-people"><LeaderCards people={section.people} headingLevel="h4" /></div></section>)}
      </div>
    </section>
    <PracticalLinks />
  </div>
</PublicLayout>
