---
import PublicImage from "@/components/PublicImage.astro";
import type { Post } from "@/types/content";
import { getPostPreview, renderPostMarkdown } from "@/lib/post-markdown";
import { withDevFresh } from "@/lib/href";
import { getPublicPostDate } from "@/lib/public-posts";

interface Props {
  post: Post;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const preview = compact ? getPostPreview(post.body) : undefined;
const date = getPublicPostDate(post);
const postAnchor = post.id ? `post-${post.id}` : undefined;
const href = withDevFresh(`/activiteiten.html${postAnchor ? `#${postAnchor}` : ""}`);
---

<article class:list={["card post-card", compact ? "post-card-compact" : "post-card-full", !compact && date && "has-date-stamp", post.featured && "post-is-featured"]} id={compact ? undefined : postAnchor}>
  {!compact && date && <div class="post-date-stamp" aria-hidden="true"><strong>{date.day}</strong><span>{date.monthShort}</span><small>{date.year}</small></div>}
  {preview?.image && (
    <a class="post-cover" href={href} aria-label={post.title}>
      <PublicImage src={preview.image.url} alt={preview.image.alt} loading="lazy" decoding="async" />
    </a>
  )}
  <div class="post-meta-row">
    {post.featured && <span class="badge">Uitgelicht</span>}
    {date && <span class="post-date"><span class="post-date-label">{date.source === "created" ? "Aangemaakt op" : "Datum"} </span><time datetime={date.datetime}>{date.label}</time></span>}
  </div>
  <h3>{compact ? <a href={href}>{post.title}</a> : post.title}</h3>
  {compact ? (
    <>
      {(post.summary || preview?.excerpt) && <p class="lead-small">{post.summary || preview?.excerpt}</p>}
      <a class="post-read-more" href={href}>Lees het bericht <span aria-hidden="true">→</span></a>
    </>
  ) : (
    <>
      {post.summary && <p class="lead-small">{post.summary}</p>}
      <div class="markdown post-body" set:html={renderPostMarkdown(post.body)} />
      <a class="post-permalink" href={href} aria-label={`Vaste link naar ${post.title}`}>Link naar dit bericht <span aria-hidden="true">↗</span></a>
    </>
  )}
</article>
