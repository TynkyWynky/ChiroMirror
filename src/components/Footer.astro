---
import type { SiteSettings } from "@/types/content";
import { getAdminBasePath } from "@/lib/admin-path";
import { publicNavLinks } from "@/lib/routes";
import { withDevFresh } from "@/lib/href";

interface Props { siteSettings: SiteSettings; showMap?: boolean; }
const { siteSettings, showMap = false } = Astro.props;
const adminLinkLabel = siteSettings.footerAdminLabel.trim();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a class="brand footer-brand" href="/">
        <img class="brand-logo" src="/assets/chir9man%20logo.png" width="700" height="700" alt="" loading="lazy" />
        <span class="brand-name"><span>Chiro</span><strong>Negenmanneke</strong></span>
      </a>
      <a class="btn footer-signup" data-signup-motion href={withDevFresh("/inschrijven.html")}>Inschrijven <span aria-hidden="true">↗</span></a>
    </div>
    <div class="footer-columns">
      <section aria-labelledby="footer-address">
        <h2 id="footer-address">Hier vind je ons</h2>
        <p>{siteSettings.address}<br /><small>{siteSettings.addressNote}</small></p>
        <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
      </section>
      <nav aria-label="Snel naar">
        <h2>Snel naar</h2>
        <ul class="footer-links">{publicNavLinks.map((item) => <li><a href={withDevFresh(item.href)}>{item.label}</a></li>)}</ul>
      </nav>
      <section aria-labelledby="footer-social">
        <h2 id="footer-social">Volg ons</h2>
        <ul class="footer-social">
          <li><a href={siteSettings.facebookUrl} target="_blank" rel="noreferrer">Facebook <span aria-hidden="true">↗</span></a></li>
          <li><a href={siteSettings.instagramUrl} target="_blank" rel="noreferrer">Instagram <span aria-hidden="true">↗</span></a></li>
          <li><a href={withDevFresh("/contact.html")}>Contact opnemen <span aria-hidden="true">→</span></a></li>
        </ul>
      </section>
    </div>
    {showMap && <div class="footer-map">
      <div class="map-wrapper">
        <iframe title="Kaart — Chiro Negenmanneke" src={siteSettings.mapEmbedUrl} allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="map-actions">
        <a class="btn" target="_blank" rel="noreferrer" href={siteSettings.mapGoogleUrl}>Route (Google Maps)</a>
        <a class="btn btn-light" target="_blank" rel="noreferrer" href={siteSettings.mapAppleUrl}>Open in Apple Maps</a>
      </div>
    </div>}
    <div class="footer-bottom">
      <div><p>{siteSettings.footerCopyright}</p><p>{siteSettings.footerDeveloper}</p></div>
      {adminLinkLabel && <a class="admin-link" href={withDevFresh(getAdminBasePath())} rel="nofollow">{adminLinkLabel}</a>}
    </div>
  </div>
</footer>
