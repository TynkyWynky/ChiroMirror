{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": [
    "dist",
    "src/features/app/**",
    "src/server/app-invite.ts",
    "src/server/notifications/**",
    "src/server/pwa.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
